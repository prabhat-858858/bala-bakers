# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas URI in .env
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/bela-bakers?retryWrites=true&w=majority

# Authentication (Generate a strong 64-character random string for production)
JWT_SECRET=replace_with_a_strong_random_secret_key_in_production
JWT_EXPIRES_IN=7d

# Initial Owner Setup (Used ONLY by npm run create-admin script, never exposed to frontend)
INITIAL_ADMIN_EMAIL=owner@belabakers.com
INITIAL_ADMIN_PASSWORD=ChangeThisStrongPassword!123

# Cloudinary Configuration (For Cake Photograph Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
